# Copie este arquivo para ".env" e troque a senha.
POSTGRES_USER=raiz
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=raiz_direta
POSTGRES_PORT=5432

# Usada pela aplicação rodando FORA do Docker (no seu terminal).
# Dentro de outro contêiner do Compose, troque "localhost" por "db".
DATABASE_URL=postgresql://raiz:troque_esta_senha@localhost:5432/raiz_direta
POSTGRES_HOST=localhost

# --- Django ---
# Gere uma chave com: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque_esta_chave
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
