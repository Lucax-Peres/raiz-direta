# Copie este arquivo para ".env" e troque a senha.
POSTGRES_USER=raiz
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=raiz_direta
POSTGRES_PORT=5432

# Usada pela aplicação rodando FORA do Docker (no seu terminal).
# Dentro de outro contêiner do Compose, troque "localhost" por "db".
DATABASE_URL=postgresql://raiz:troque_esta_senha@localhost:5432/raiz_direta
